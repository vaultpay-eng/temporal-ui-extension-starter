{
    "manifest_version": 3,
    "name": "VaultPay Temporal UI",
    "version": "0.2.3",
    "description": "Queue filters, workflow family trees, and configurable Search Attribute columns for local Temporal and Temporal Cloud.",
    "permissions": [
        "storage"
    ],
    "action": {
        "default_title": "VaultPay Temporal UI",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png",
            "48": "icons/icon-48.png",
            "128": "icons/icon-128.png"
        }
    },
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://cloud.temporal.io/namespaces/*",
                "http://localhost/*",
                "http://127.0.0.1/*"
            ],
            "js": [
                "inject.js",
                "apiInject.js"
            ],
            "world": "MAIN",
            "run_at": "document_start"
        },
        {
            "matches": [
                "https://cloud.temporal.io/namespaces/*",
                "http://localhost/*",
                "http://127.0.0.1/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "content.css"
            ],
            "world": "ISOLATED",
            "run_at": "document_start"
        }
    ]
}
